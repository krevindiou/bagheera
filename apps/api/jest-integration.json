{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "src",
  "testEnvironment": "node",
  "testRegex": ".integration-spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest",
    "^.+\\.js$": "<rootDir>/../test/esm-to-cjs-transform.cjs"
  },
  "transformIgnorePatterns": ["/node_modules/(?!.*(@nestjs|nestjs-pino))"],
  "setupFiles": ["dotenv/config"],
  "setupFilesAfterEnv": ["<rootDir>/../test/reset-rate-limits.ts"],
  "globalSetup": "<rootDir>/../test/integration-global-setup.ts",
  "globalTeardown": "<rootDir>/../test/integration-global-teardown.ts",
  "testTimeout": 30000,
  "reporters": [
    "default",
    ["jest-junit", { "outputName": "junit-integration.xml" }]
  ]
}
