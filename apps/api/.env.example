# Copy to apps/api/.env for local (native) development against the compose
# services started via `docker compose up -d postgres valkey` at the repo root.
PORT=3000
DATABASE_URL=postgres://bagheera:bagheera@localhost:5432/bagheera
VALKEY_URL=redis://localhost:6379
# Dev-only key, freshly generated for this example file — still change it
# before reusing this env file anywhere beyond a disposable local checkout
# (e.g. a shared/staging deployment), same as SESSION_SECRET/CSRF_SECRET below.
CRYPTO_KEYS={"1":"A8IGSXBmWg58OWNxIXm7f846RROEq8S0SZFJDGU/grQ="}
CRYPTO_ACTIVE_KEY_ID=1
SESSION_SECRET=dev-session-secret-change-me
CSRF_SECRET=dev-csrf-secret-change-me
# Base URL used to build links embedded in emails (activation, password reset).
APP_URL=http://localhost:5173
# SMTP connection string (nodemailer URL form) and sender address for outgoing email.
EMAIL_SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Bagheera <no-reply@bagheera.example>
# Optional. Unset locally: logs go to stdout as JSON (pretty-printed under
# start:dev) and errors aren't reported anywhere beyond that.
# LOG_LEVEL=info
# SENTRY_DSN=
# Optional. Id of the category powering the dashboard's "last salary"
# indicator. Defaults to 1 (the seeded "Salary" category's id).
# SALARY_CATEGORY_ID=1
