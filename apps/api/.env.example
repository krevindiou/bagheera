# Copy to apps/api/.env for local (native) development against the compose
# services started via `docker compose up -d postgres valkey` at the repo root.
PORT=3000
DATABASE_URL=postgres://bagheera:bagheera@localhost:5432/bagheera
VALKEY_URL=redis://localhost:6379
CRYPTO_KEYS={"1":"8mJ0e7Z3vscIKX6Sp4hzw1tCTQiSVF0gzOREHMhYTYM="}
CRYPTO_ACTIVE_KEY_ID=1
SESSION_SECRET=dev-session-secret-change-me
CSRF_SECRET=dev-csrf-secret-change-me
# Base URL used to build links embedded in emails (activation, password reset).
APP_URL=http://localhost:5173
# SMTP connection string (nodemailer URL form) and sender address for outgoing email.
EMAIL_SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Bagheera <no-reply@bagheera.example>
