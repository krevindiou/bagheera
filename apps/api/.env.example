# Copy to apps/api/.env; used by the `api` container started with `make up`.
# Hostnames below are for the host; docker/compose.yml overrides them for the
# container network.
PORT=3000
DATABASE_URL=postgres://bagheera:bagheera@localhost:5432/bagheera
VALKEY_URL=redis://localhost:6379
# Optional: Valkey's requirepass, kept out of VALKEY_URL (production sets it;
# the dev Valkey has no password).
# VALKEY_PASSWORD=
# Dev-only key: change it, like SESSION_SECRET/CSRF_SECRET, anywhere beyond
# a local checkout (production refuses these published values).
CRYPTO_KEYS={"1":"A8IGSXBmWg58OWNxIXm7f846RROEq8S0SZFJDGU/grQ="}
CRYPTO_ACTIVE_KEY_ID=1
SESSION_SECRET=dev-session-secret-change-me
CSRF_SECRET=dev-csrf-secret-change-me
# Optional: idle session timeout in seconds; 1800 (30 minutes) if unset.
# SESSION_IDLE_TTL_SECONDS=1800
# Base URL used to build links embedded in emails (sign-up confirmation, email change).
APP_URL=http://localhost:5173
# WebAuthn/passkey relying-party identity. RP_ID is the bare domain the
# passkey is bound to (no scheme/port — "localhost" is a browser-allowed
# special case for local dev over http); RP_ORIGIN is the exact scheme+host
# the browser sends, checked against every ceremony's clientDataJSON.
RP_ID=localhost
RP_NAME=Bagheera
RP_ORIGIN=http://localhost:5173
# SMTP connection string (nodemailer URL form) and sender address for outgoing email.
EMAIL_SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Bagheera <no-reply@bagheera.example>
# Time zone that defines "today" and month boundaries (IANA name) for members
# with none of their own (see member.time_zone); UTC if unset.
# APP_TIMEZONE=Europe/Paris
# Optional. Unset locally: logs go to stdout as JSON (pretty-printed under
# start:dev) and errors aren't reported anywhere beyond that.
# LOG_LEVEL=info
# SENTRY_DSN=
