{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "generate:api-client": "openapi-typescript http://localhost:3000/api/docs-json -o src/api/schema.d.ts",
    "lint": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,vue}\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue}\" \"e2e/**/*.ts\""
  },
  "dependencies": {
    "@bagheera/money": "workspace:*",
    "@bagheera/reference-data": "workspace:*",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@sentry/vue": "^11.1.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@tanstack/vue-query": "^5.104.0",
    "@vee-validate/zod": "^4.15.1",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "pinia": "^4.0.3",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.43",
    "vue-chartjs": "^5.3.4",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.2",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  }
}
