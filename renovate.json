{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "docker:pinDigests"],
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "One weekly PR for minor and patch updates",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "minor and patch updates"
    },
    {
      "description": "Majors get their own PR, one per package",
      "matchUpdateTypes": ["major"],
      "groupName": null
    },
    {
      "description": "connect-redis 11 is ESM-only (no require export); the API compiles to CommonJS and fails to boot",
      "matchPackageNames": ["connect-redis"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Renovate finds no release timestamp for a digest bump and would hold it forever; the image-age workflow checks the digest's age on these PRs instead",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest"],
      "matchDepNames": [
        "caddy",
        "postgres",
        "valkey/valkey",
        "docker/dockerfile",
        "node",
        "axllent/mailpit"
      ],
      "minimumReleaseAge": null
    }
  ]
}
