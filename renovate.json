{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "docker:pinDigests"],
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "One weekly PR for minor and patch updates",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "minor and patch updates"
    },
    {
      "description": "Majors get their own PR, one per package",
      "matchUpdateTypes": ["major"],
      "groupName": null
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Kamal version installed by the deploy job",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": ["gem install kamal .*--version (?<currentValue>\\S+)"],
      "datasourceTemplate": "rubygems",
      "depNameTemplate": "kamal"
    }
  ]
}
