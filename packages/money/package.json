{
  "name": "@bagheera/money",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "format": "oxfmt \"src/**/*.ts\"",
    "lint": "oxlint --fix src vitest.config.mts",
    "lint:check": "oxlint --max-warnings 0 --report-unused-disable-directives src vitest.config.mts",
    "format:check": "oxfmt --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
