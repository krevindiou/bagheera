# Copy to .env.prod at the repo root before running (--env-file is required
# so the postgres/valkey service definitions pick up the same credentials
# the api container is given below):
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d

POSTGRES_USER=bagheera
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bagheera

# Consumed by the api container's env_file; hostnames are the compose
# service names, resolved on the compose network.
DATABASE_URL=postgres://bagheera:change-me@postgres:5432/bagheera
VALKEY_URL=redis://valkey:6379
# JSON map of key id -> base64 AES-256 key, e.g. {"1":"<base64 32 bytes>"}
CRYPTO_KEYS={"1":"replace-with-a-generated-base64-32-byte-key"}
CRYPTO_ACTIVE_KEY_ID=1
SESSION_SECRET=change-me
CSRF_SECRET=change-me
# Public URL used to build links embedded in emails (activation, password reset).
APP_URL=https://localhost
EMAIL_SMTP_URL=smtp://mailhost:587
EMAIL_FROM=Bagheera <no-reply@bagheera.example>

# Caddy's site address; "localhost" (default) gets a locally-trusted cert,
# a real hostname gets one via public ACME.
CADDY_SITE_ADDRESS=localhost
HTTP_PORT=80
HTTPS_PORT=443
