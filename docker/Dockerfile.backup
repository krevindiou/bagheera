# syntax=docker/dockerfile:1@sha256:572cebbc2b15e6f84c077742952674889cb63cd5e9b80abdffcbe587b6f19183

# Nightly Postgres backup: pg_dump pushed to a restic repository and/or
# age-encrypted and emailed, scheduled by supercronic. The base is the same
# pinned image Dockerfile.postgres builds the server from, so pg_dump always
# matches the server major version.
FROM postgres:19-alpine@sha256:cac45fb483caee3668946088a1c0532db89d5285c28dbfeac889b4068296e06f

# `apk upgrade`: the digest-pinned base can lag behind Alpine's security fixes,
# which the image scan would then fail on. gosu (the base's root-to-postgres
# switch, a Go binary with CVEs of its own) is unused here: this image never
# runs as root.
RUN apk upgrade --no-cache \
  && apk add --no-cache restic age curl tzdata openssh-client-default supercronic \
  && rm -f /usr/local/bin/gosu \
  && adduser -D -u 10001 backup \
  && mkdir -p /home/backup /backups /tmp/backup /usr/local/lib/backup \
  && chown backup:backup /home/backup /backups /tmp/backup

# A script that is missing fails the build (install exits non-zero).
COPY docker/backup/*.sh /opt/backup/
RUN for name in validate run check entrypoint healthcheck; do \
      install -m 0755 "/opt/backup/$name.sh" "/usr/local/bin/backup-$name"; \
    done \
  && for lib in lib.sh mail.sh; do \
      install -m 0755 "/opt/backup/$lib" "/usr/local/lib/backup/$lib"; \
    done \
  && rm -rf /opt/backup

# The postgres base image sets STOPSIGNAL SIGINT; supercronic stops on SIGTERM.
STOPSIGNAL SIGTERM

USER backup
WORKDIR /home/backup
ENTRYPOINT ["backup-entrypoint"]
