# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
# Dev-only image for the web app's Vite dev server (HMR, proxying to the
# api service). Production instead builds static assets via docker/Dockerfile.caddy,
# served by Caddy — no runtime Node needed in prod.
#   docker build -f docker/Dockerfile.web --target dev -t bagheera-web-dev .
# Build context is the repo root (pnpm workspace).

# Pinned by digest so a floated `node:26-alpine` retag can't silently
# change what this builds against; Renovate's docker:pinDigests preset
# (renovate.json) keeps this current as the tag moves.
FROM node:26-alpine@sha256:6bd9ab43c0ec0190ca7b2d193906cb8b7edf6e7f4afa43ddeccd6452710bffb5 AS base
# Node 25+ no longer bundles corepack.
RUN npm install -g corepack@0.36.0 && npm cache clean --force && corepack enable
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/web/package.json apps/web/package.json
COPY packages ./packages
# --filter web... : web's deps + any workspace packages/* it depends on.
RUN pnpm install --frozen-lockfile --filter web...

FROM deps AS dev
# Source comes in via bind mount (see docker/compose.yml); node_modules
# paths are covered by named volumes there so the bind mount doesn't
# shadow the deps layer's install.
RUN chown -R node:node /app
ENV NODE_ENV=development
USER node
EXPOSE 5173
CMD ["pnpm", "--filter", "web", "dev", "--", "--host", "0.0.0.0"]
