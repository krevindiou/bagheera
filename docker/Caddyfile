# Serves the built SPA. The API is same-origin but routed by Uncloud's Caddy
# straight to its own service (docker/compose.prod.yml), never through here.
# $CADDY_SITE_ADDRESS: "localhost" (default) gets a locally-trusted cert, a
# real hostname a public ACME one, "http://:80" plain HTTP behind a
# TLS-terminating proxy (Uncloud's Caddy).

{$CADDY_SITE_ADDRESS:localhost} {
	encode gzip

	# The SPA's security headers; the API sets its own with helmet().
	header {
		# Pins HTTPS for two years: set only where the site is always served
		# over HTTPS (docker/compose.prod.yml). Anywhere else — a local run on
		# https://localhost — max-age=0 keeps browsers from pinning HTTPS for
		# every dev server on localhost.
		Strict-Transport-Security "{$HSTS_POLICY:max-age=0}"
		# The built SPA loads nothing but its own files: no inline script or
		# style, self-hosted fonts. The one outside origin is Sentry's ingest
		# host, when SENTRY_DSN is set (docker-entrypoint.sh derives it).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' {$SENTRY_INGEST_ORIGIN}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# Uncloud's readiness check of this container (docker/compose.prod.yml).
	# It probes the container directly; public /health traffic goes to the
	# api service.
	handle /health {
		respond "ok" 200
	}

	# The SPA's deployment settings, rendered from the container's env so one
	# image serves every deployment. It shadows the empty placeholder the
	# build ships in /srv, and must never be cached.
	handle /runtime-config.js {
		header Content-Type application/javascript
		header Cache-Control no-store
		respond `window.__RUNTIME_CONFIG__={"sentryDsn":"{$SENTRY_DSN}"};`
	}

	# Vite content-hashes everything under /assets/, so those files never change
	# and can be cached for good. Anything else (index.html, the SPA fallback,
	# favicon, robots.txt) must be revalidated so a deploy shows on next load.
	# The file check keeps a missing asset (served index.html by the fallback)
	# from being cached as immutable.
	handle {
		root * /srv

		@hashed {
			path /assets/*
			file
		}
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		@mutable not {
			path /assets/*
			file
		}
		header @mutable Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
