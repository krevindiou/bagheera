# Production edge: serves the built SPA and reverse-proxies API routes to
# the api container, same-origin. $CADDY_SITE_ADDRESS sets the whole site
# address: default "localhost" gets a locally-trusted cert; a real hostname
# (e.g. app.example.com) gets one via public ACME; "http://:80" serves plain
# HTTP with no TLS of its own, for when something in front of this container
# already terminates it (Kamal's own proxy does).
{
	servers {
		# Kamal's proxy forwards the real client address in X-Forwarded-For.
		# By default Caddy trusts no upstream proxy, so reverse_proxy below
		# *replaces* that header with the peer's own address (Kamal's proxy
		# container) instead of appending to it: every request would then
		# reach the api from one and the same IP, collapsing its per-IP rate
		# limits into a single site-wide bucket. Trusting the private ranges
		# Kamal's proxy connects from (the Docker network) makes Caddy append,
		# giving the two-hop chain apps/api/src/main.ts's `trust proxy`
		# count expects.
		trusted_proxies static private_ranges
	}
}

{$CADDY_SITE_ADDRESS:localhost} {
	encode gzip

	@api path /health /api* /auth* /members* /banks* /accounts* /operations* /schedulers* /reports* /dashboard* /reference-data* /webauthn*
	reverse_proxy @api api:3000 {
		header_up X-Forwarded-Proto https
	}

	root * /srv
	try_files {path} /index.html
	file_server
}
