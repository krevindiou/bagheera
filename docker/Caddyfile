# Production edge: serves the built SPA, same-origin with the API (which
# kamal-proxy now routes to directly — see config/deploy.api.yml — not
# through this container at all; apps/api/src/main.ts's `trust proxy` count
# was updated to match that one-hop change). $CADDY_SITE_ADDRESS sets the
# whole site address: default "localhost" gets a locally-trusted cert; a
# real hostname (e.g. app.example.com) gets one via public ACME; "http://:80"
# serves plain HTTP with no TLS of its own, for when something in front of
# this container already terminates it (Kamal's own proxy does).

{$CADDY_SITE_ADDRESS:localhost} {
	encode gzip

	# Browser security headers for the SPA. The API (a separate Kamal app
	# now, see config/deploy.api.yml) no longer passes through this
	# container at all, so it's covered only by its own helmet() headers —
	# already equivalent for the headers set below (CSP content differs by
	# origin, which is expected: each serves its own).
	header {
		# Pins HTTPS for two years: set only where the site is always served
		# over HTTPS (config/deploy.yml). Anywhere else — a local run on
		# https://localhost — max-age=0 keeps browsers from pinning HTTPS for
		# every dev server on localhost.
		Strict-Transport-Security "{$HSTS_POLICY:max-age=0}"
		# The built SPA loads nothing but its own files: no inline script or
		# style, self-hosted fonts. The one outside origin is Sentry's ingest
		# host, when VITE_SENTRY_DSN is set (config/deploy.yml derives it).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' {$SENTRY_INGEST_ORIGIN}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# Answers kamal-proxy's own per-deploy readiness check of *this*
	# container (config/deploy.yml's proxy.healthcheck) — a direct
	# container-to-container probe that bypasses the public /health,/api*
	# path-prefix routing rule that sends real traffic on those paths to
	# the separate api app (config/deploy.api.yml) instead of here.
	handle /health {
		respond "ok" 200
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
