# Optional overrides for docker/compose.yml: copy to docker/.env (Compose
# reads .env from this directory, not the repo root). Every value below is
# already the default.

# Postgres (service: postgres)
POSTGRES_USER=bagheera
POSTGRES_PASSWORD=bagheera
POSTGRES_DB=bagheera
POSTGRES_PORT=5432

# Valkey (service: valkey)
VALKEY_PORT=6379

# Mailpit, the SMTP catcher for local/E2E email (service: mailpit). Web UI
# and API on the HTTP port.
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# Host ports of the api and web dev servers
API_PORT=3000
WEB_PORT=5173
