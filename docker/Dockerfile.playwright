# syntax=docker/dockerfile:1
# Runs apps/web's e2e suite in a container: Playwright's Chromium needs
# glibc (web's dev image is musl), and the host needs nothing installed.
# Build context is the repo root, e.g.:
#   docker build -f docker/Dockerfile.playwright -t bagheera-playwright .
#
# PLAYWRIGHT_VERSION must equal apps/web's @playwright/test version (the
# image's browsers are tied to it). The Makefile passes it; no default, so
# building without it fails fast.
ARG PLAYWRIGHT_VERSION
FROM mcr.microsoft.com/playwright:v${PLAYWRIGHT_VERSION}-noble

# Otherwise corepack's first pnpm run prompts to download, with no TTY.
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /app

# Deps baked in from here; e2e source itself comes in via bind mount (see
# docker/compose.yml) so edits don't need a rebuild. node_modules paths are
# covered by named volumes there so the bind mount doesn't shadow them.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/web/package.json apps/web/package.json
COPY packages ./packages
RUN pnpm install --frozen-lockfile --filter web...

# Non-root, or test-results/ and playwright-report/ come out root-owned on
# the host. "ubuntu" (uid 1000, like the other images' "node"), not
# "pwuser" (1001): bind mounts match numeric uids.
RUN chown -R ubuntu:ubuntu /app
USER ubuntu

# Pre-warms pnpm in ubuntu's own corepack cache (the install ran as root).
RUN pnpm --version

WORKDIR /app/apps/web
CMD ["sleep", "infinity"]
