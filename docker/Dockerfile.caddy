# syntax=docker/dockerfile:1
# Builds the production edge image: the web app's static assets served by
# Caddy, which also reverse-proxies API routes to the api container.
#   docker build -f docker/Dockerfile.caddy -t bagheera-caddy .
# Build context is the repo root (pnpm workspace).

FROM node:24-alpine AS deps
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY packages ./packages
# --filter web... : web's deps + any workspace packages/* it depends on.
RUN pnpm install --frozen-lockfile --filter web...

FROM deps AS build
COPY . .
# Vite bakes VITE_* vars in at build time, so this has to be a build arg —
# a runtime env var on the container would be too late.
ARG VITE_SENTRY_DSN
RUN pnpm --filter web build

FROM caddy:2-alpine
# Non-root: create a caddy user/group and grant the binary
# CAP_NET_BIND_SERVICE via a file capability so it can still bind 80/443
# without running as root. Docker's default capability bounding set
# already includes NET_BIND_SERVICE, so no extra cap_add is needed.
RUN apk add --no-cache libcap \
	&& setcap cap_net_bind_service=+ep /usr/bin/caddy \
	&& addgroup -S caddy && adduser -S -G caddy caddy \
	&& mkdir -p /data /config \
	&& chown -R caddy:caddy /data /config
COPY --from=build --chown=caddy:caddy /app/apps/web/dist /srv
COPY docker/Caddyfile /etc/caddy/Caddyfile
USER caddy
