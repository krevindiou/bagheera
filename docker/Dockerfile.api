# syntax=docker/dockerfile:1
# Build context is the repo root (pnpm workspace), e.g.:
#   docker build -f docker/Dockerfile.api -t bagheera-api .

# Pinned by digest so a floated `node:24-alpine` retag can't silently
# change what this builds against; Renovate's docker:pinDigests preset
# (renovate.json) keeps this current as the tag moves.
FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS base
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/api/package.json apps/api/package.json
COPY packages ./packages
# --filter api... : api's deps + any workspace packages/* it depends on.
RUN pnpm install --frozen-lockfile --filter api...

FROM deps AS dev
# Dev image: node_modules baked in from the deps layer above, source comes
# in via bind mount (see docker/compose.yml) so nest --watch picks up edits
# without a rebuild. node_modules paths are covered by named volumes there
# so the bind mount doesn't shadow them.
RUN chown -R node:node /app
# Gives `node` the host docker.sock's group, for Testcontainers. The
# Makefile passes the gid; no default, so building without it fails fast.
ARG DOCKER_GID
RUN (addgroup -g "$DOCKER_GID" docker || true) \
  && EXISTING_GROUP="$(getent group "$DOCKER_GID" | cut -d: -f1)" \
  && adduser node "${EXISTING_GROUP:-docker}"
ENV NODE_ENV=development
USER node
EXPOSE 3000
CMD ["pnpm", "--filter", "api", "start:dev"]

FROM deps AS build
COPY . .
# api... : build api's workspace packages/* dependencies first (topological
# order), then api itself — pnpm run --filter doesn't build a filtered
# package's dependencies on its own.
RUN pnpm --filter api... build
RUN pnpm --filter api deploy --prod --legacy /app/deploy/api

FROM base AS runtime
ENV NODE_ENV=production
COPY --from=build --chown=node:node /app/deploy/api/node_modules ./node_modules
COPY --from=build --chown=node:node /app/deploy/api/package.json ./package.json
COPY --from=build --chown=node:node /app/apps/api/dist ./dist
COPY --from=build --chown=node:node /app/apps/api/drizzle ./drizzle
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s CMD node -e "require('http').get('http://127.0.0.1:'+(process.env.PORT||3000)+'/health',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"
CMD ["node", "dist/main.js"]
