# Variables docker/compose.prod.yml reads at deploy time. Copy to
# docker/prod.env (git-ignored), fill in, and export them into the shell that
# runs `uc deploy`. Never commit real values.

# Docker Hub account the images are published under, and the image tag to
# roll out (a git SHA of a green main build; an older one rolls back).
DOCKERHUB_USERNAME=
TAG=

# Public hostname of the site; its DNS A record must point at the host.
APP_DOMAIN=

# Optional: IANA time zone for members with none of their own.
# APP_TIMEZONE=Europe/Paris

# Generate each with `openssl rand -hex 32`. POSTGRES_PASSWORD goes into
# DATABASE_URL unencoded, so keep it URL-safe.
POSTGRES_PASSWORD=
VALKEY_PASSWORD=
SESSION_SECRET=
CSRF_SECRET=

# Field encryption keys: JSON map of key id to base64 32-byte key, and the id
# in use. e.g. CRYPTO_KEYS={"1":"<openssl rand -base64 32>"}
CRYPTO_KEYS=
CRYPTO_ACTIVE_KEY_ID=

# Outgoing email: nodemailer connection URL and sender address.
EMAIL_SMTP_URL=
EMAIL_FROM=

# Optional Sentry error reporting, off when unset. SENTRY_INGEST_ORIGIN is the
# scheme and host of the DSN (https://<host>), which the SPA's
# Content-Security-Policy must allow.
# SENTRY_DSN=
# SENTRY_INGEST_ORIGIN=
