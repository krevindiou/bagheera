# Variables docker/compose.prod.yml reads at deploy time. Copy to
# docker/prod.env (git-ignored) and fill in; scripts/deploy.sh sources it, so
# it is shell syntax: single-quote any value with special characters. Never
# commit real values. The image tag is not here: it is the argument of
# `make deploy [TAG=<version>]` (latest release by default).

# Registry and owner the images are pulled from. Leave it as is to use the
# public images; change it only if you publish your own (docs/deploying.md).
IMAGE_NAMESPACE=ghcr.io/krevindiou

# Public hostname of the site; its DNS A record must point at the host.
APP_DOMAIN=

# Optional: IANA time zone for members with none of their own.
# APP_TIMEZONE=Europe/Paris

# Generate each with `openssl rand -hex 32`. POSTGRES_PASSWORD goes into
# DATABASE_URL unencoded, so keep it URL-safe.
POSTGRES_PASSWORD=
VALKEY_PASSWORD=
SESSION_SECRET=
CSRF_SECRET=

# Field encryption keys: JSON map of key id to base64 32-byte key, and the id
# in use. e.g. CRYPTO_KEYS='{"1":"<openssl rand -base64 32>"}'
CRYPTO_KEYS=
CRYPTO_ACTIVE_KEY_ID=

# Outgoing email: nodemailer connection URL and sender, which needs quotes
# when written as a name and address, e.g. EMAIL_FROM='Bagheera <no-reply@<your-domain>>'
# The backup service sends through the same URL with curl, so keep it to the
# form both read: smtp://user:password@host:587 (STARTTLS) or
# smtps://user:password@host:465 (TLS from the start), with no nodemailer
# query options (?secure=...). Not smtp://host:465: the api may cope, but curl
# would try STARTTLS on a port that expects TLS from the start.
EMAIL_SMTP_URL=
EMAIL_FROM=

# Optional Sentry errors, tracing, logs and (api) runtime metrics, off when
# unset: one DSN for the api, one for the SPA. The SPA's reaches every
# browser, so it is not a secret.
# SENTRY_DSN=
# WEB_SENTRY_DSN=

# Nightly database backup (the `backup` service). Set at least one destination
# below, restic and/or email, or BACKUP_DISABLED=true: the deploy fails on a bad
# configuration. Only the Postgres dump is backed up. This file is NOT: keep a
# copy of it elsewhere, because losing CRYPTO_KEYS makes every backup unreadable
# (the encrypted fields in the dump cannot be decrypted without them). A stopped
# backup container sends nothing, not even an alert.
# BACKUP_DISABLED=true

# 5-field cron expression, in APP_TIMEZONE.
BACKUP_SCHEDULE='0 3 * * *'

# The longest each step (the dump, each restic command) may take before the run
# fails and alerts, as `timeout` reads it: a number, optionally followed by s,
# m, h or d (default 2h).
# BACKUP_STEP_TIMEOUT=2h

# Destination 1: a restic repository (https://restic.readthedocs.io), encrypted
# with RESTIC_PASSWORD (keep it with your copy of this file: without it the
# repository cannot be read). Initialised on first use. One repository per
# Bagheera instance: two sharing one would prune each other's snapshots.
# Examples:
#   a named volume on the host: /backups/restic (a local path must be under
#                               /backups, or it is lost at the next deploy)
#   S3-compatible storage:      s3:https://s3.example.com/<bucket>/bagheera
#   an SFTP server:             sftp:<user>@<host>:/path/to/repo
# A weekly `restic check` alerts on a damaged repository.
# RESTIC_REPOSITORY=
# RESTIC_PASSWORD=
# For an s3: repository:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# For an sftp: repository: the private key (multi-line, so single-quoted, shell
# syntax) and the server's host keys (`ssh-keyscan <host>`), mandatory with the
# key: the backup never trusts an unknown host.
# BACKUP_SFTP_PRIVATE_KEY='-----BEGIN OPENSSH PRIVATE KEY-----
# ...
# -----END OPENSSH PRIVATE KEY-----'
# BACKUP_SFTP_KNOWN_HOSTS=

# Snapshots to keep, restic destination only (defaults shown).
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# BACKUP_KEEP_MONTHLY=6

# Destination 2: the dump, encrypted with age, attached to an email sent through
# EMAIL_SMTP_URL / EMAIL_FROM above. Generate the key pair on your own machine,
# not the server: `age-keygen -o bagheera-backup.key`, keep that file (it is the
# only way to read the backups) somewhere safe and off this host, and put only
# the public key it prints (`age1...`) in BACKUP_EMAIL_AGE_RECIPIENT. The dump is
# never sent in clear.
# BACKUP_EMAIL_TO=
# BACKUP_EMAIL_AGE_RECIPIENT=
# Cap on the encrypted file, in MiB (default 10). Over it the email fails and
# alerts, it is never skipped silently. Base64 on the wire adds about a third:
# lower it if your mail provider's limit is around 10 MB.
# BACKUP_EMAIL_MAX_MB=10

# Failure alerts go to this address (without it, failures only show in the
# container logs). It and BACKUP_EMAIL_TO each take one bare address
# (ops@example.com), not a name or a list. BACKUP_REPORT=always also emails each success; the default,
# failure, only emails failures.
# BACKUP_ALERT_EMAIL=
# BACKUP_REPORT=failure

# Integration tests only: lets the backup send email without TLS. Leave unset.
# BACKUP_SMTP_ALLOW_PLAINTEXT=true
