# Variables docker/compose.prod.yml reads at deploy time. Copy to
# docker/prod.env (git-ignored) and fill in; scripts/deploy.sh sources it, so
# it is shell syntax: single-quote any value with special characters. Never
# commit real values. The image tag is not here: it is the argument of
# `make deploy TAG=<git sha>`.

# Docker Hub account the images are published under.
DOCKERHUB_USERNAME=

# Public hostname of the site; its DNS A record must point at the host.
APP_DOMAIN=

# Optional: IANA time zone for members with none of their own.
# APP_TIMEZONE=Europe/Paris

# Generate each with `openssl rand -hex 32`. POSTGRES_PASSWORD goes into
# DATABASE_URL unencoded, so keep it URL-safe.
POSTGRES_PASSWORD=
VALKEY_PASSWORD=
SESSION_SECRET=
CSRF_SECRET=

# Field encryption keys: JSON map of key id to base64 32-byte key, and the id
# in use. e.g. CRYPTO_KEYS='{"1":"<openssl rand -base64 32>"}'
CRYPTO_KEYS=
CRYPTO_ACTIVE_KEY_ID=

# Outgoing email: nodemailer connection URL and sender address.
EMAIL_SMTP_URL=
EMAIL_FROM=

# Optional Sentry error reporting, off when unset: one DSN for the api, one for
# the SPA. The SPA's reaches every browser, so it is not a secret.
# SENTRY_DSN=
# WEB_SENTRY_DSN=
