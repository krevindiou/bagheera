# Postgres (docker compose service: postgres)
POSTGRES_USER=bagheera
POSTGRES_PASSWORD=bagheera
POSTGRES_DB=bagheera
POSTGRES_PORT=5432

# Valkey (docker compose service: valkey)
VALKEY_PORT=6379

# Mailpit — SMTP catcher for local/E2E email verification (docker compose
# service: mailpit). Web UI/API on the HTTP port.
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# apps/api, run natively against the compose services above
DATABASE_URL=postgres://bagheera:bagheera@localhost:5432/bagheera
VALKEY_URL=redis://localhost:6379
