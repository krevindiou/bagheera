# api/web set CI=true in docker/compose.yml specifically so pnpm's
# deps-status-check auto-confirms purging a stale node_modules dir
# instead of prompting on a TTY that doesn't exist in a container. The
# playwright service can't use that same trick — it reuses CI for its own
# reporter selection (see docker/compose.yml's playwright service) and
# needs it to reflect the real host CI state, empty locally. Setting this
# directly makes every service TTY-safe regardless of CI, which
# packages/money's per-service node_modules volumes (fresh and empty on
# every ephemeral e2e run — see docker/compose.yml) need.
confirm-modules-purge=false
