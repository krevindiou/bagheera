# Secrets for config/deploy.yml and config/deploy.api.yml. No values here:
# each is read from the deploying shell's environment, so this file is safe
# to commit. Export them (from CI secrets, a password manager, …) before
# running kamal.

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

POSTGRES_PASSWORD=$POSTGRES_PASSWORD
DATABASE_URL=$DATABASE_URL
VALKEY_URL=$VALKEY_URL
# The valkey accessory's requirepass, kept out of VALKEY_URL.
VALKEY_PASSWORD=$VALKEY_PASSWORD
CRYPTO_KEYS=$CRYPTO_KEYS
CRYPTO_ACTIVE_KEY_ID=$CRYPTO_ACTIVE_KEY_ID
SESSION_SECRET=$SESSION_SECRET
CSRF_SECRET=$CSRF_SECRET
EMAIL_SMTP_URL=$EMAIL_SMTP_URL
EMAIL_FROM=$EMAIL_FROM
# Optional; empty means the api reports errors nowhere.
SENTRY_DSN=${SENTRY_DSN:-}
