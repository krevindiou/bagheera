# Secrets referenced from config/deploy.yml (registry password, and the
# accessories' env/secret lists). Values are never written here — this file
# only pulls them from the deploying shell's environment, so it's safe to
# commit. Populate those environment variables from whatever secrets store
# CI/the operator uses (a password manager, GitHub Actions secrets, etc.)
# before running `kamal deploy` / `kamal accessory boot`.

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

POSTGRES_PASSWORD=$POSTGRES_PASSWORD
DATABASE_URL=$DATABASE_URL
VALKEY_URL=$VALKEY_URL
CRYPTO_KEYS=$CRYPTO_KEYS
CRYPTO_ACTIVE_KEY_ID=$CRYPTO_ACTIVE_KEY_ID
SESSION_SECRET=$SESSION_SECRET
CSRF_SECRET=$CSRF_SECRET
EMAIL_SMTP_URL=$EMAIL_SMTP_URL
EMAIL_FROM=$EMAIL_FROM
