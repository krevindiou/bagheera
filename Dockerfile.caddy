# syntax=docker/dockerfile:1
# Builds the production edge image: the web app's static assets served by
# Caddy, which also reverse-proxies API routes to the api container.
#   docker build -f Dockerfile.caddy -t bagheera-caddy .
# Build context is the repo root (pnpm workspace).

FROM node:20-alpine AS deps
RUN corepack enable
WORKDIR /app
# Workspace install resolves apps/api's deps too; argon2 compiles a native
# addon on install.
RUN apk add --no-cache python3 make g++
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages ./packages
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY . .
# Vite bakes VITE_* vars in at build time, so this has to be a build arg —
# a runtime env var on the container would be too late.
ARG VITE_SENTRY_DSN
RUN pnpm --filter web build

FROM caddy:2-alpine
COPY --from=build /app/apps/web/dist /srv
COPY Caddyfile /etc/caddy/Caddyfile
