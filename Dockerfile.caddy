# syntax=docker/dockerfile:1
# Builds the production edge image: the web app's static assets served by
# Caddy, which also reverse-proxies API routes to the api container.
#   docker build -f Dockerfile.caddy -t bagheera-caddy .
# Build context is the repo root (pnpm workspace).

FROM node:24-alpine AS deps
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY packages ./packages
# --filter web... : web's deps + any workspace packages/* it depends on.
RUN pnpm install --frozen-lockfile --filter web...

FROM deps AS build
COPY . .
# Vite bakes VITE_* vars in at build time, so this has to be a build arg —
# a runtime env var on the container would be too late.
ARG VITE_SENTRY_DSN
RUN pnpm --filter web build

FROM caddy:2-alpine
COPY --from=build /app/apps/web/dist /srv
COPY Caddyfile /etc/caddy/Caddyfile
