{
  "name": "bagheera",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "bootstrap": "pnpm install --frozen-lockfile && pnpm --filter @bagheera/money --filter @bagheera/reference-data build",
    "format": "oxfmt --disable-nested-config \"**/*.{json,yml,yaml,md,mjs,css,html}\"",
    "format:check": "oxfmt --check --disable-nested-config \"**/*.{json,yml,yaml,md,mjs,css,html}\"",
    "check": "pnpm run \"/^check:/\"",
    "check:lint": "pnpm -r lint:check",
    "check:format": "pnpm -r format:check && pnpm run format:check",
    "check:types": "pnpm --filter api exec tsc -p tsconfig.json --noEmit",
    "check:specs": "node scripts/check-integration-spec-coverage.mjs",
    "check:hooks": ".claude/hooks/test.sh",
    "check:audit": "pnpm audit --prod --audit-level=high",
    "check:dedupe": "pnpm dedupe --check",
    "check:knip": "pnpm dlx knip@6.41.0"
  },
  "devDependencies": {
    "oxfmt": "^0.78.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
